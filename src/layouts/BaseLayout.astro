---
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";

const { title = "Spider-Man Universe" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-900 text-gray-100 min-h-screen flex flex-col font-sans">
    <header class="bg-red-700 text-white p-4 shadow-md">
      <div
        class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4"
      >
        <h1 class="text-2xl font-bold tracking-wide">🕷️ Spider-Verse Hub</h1>
        <Navigation />
      </div>
    </header>

    <main class="max-w-5xl mx-auto p-6 flex-grow w-full">
      <slot />
    </main>

    <footer
      class="bg-red-950 text-gray-300 text-center p-4 text-sm mt-8 border-t border-red-800"
    >
      <p>© 2026 Spider-Man Fan Site | MTM6407 Project</p>
    </footer>
  </body>
</html>
