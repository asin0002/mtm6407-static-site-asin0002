---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Actors & Media | Spider-Verse Hub">
  <h2 class="text-3xl font-bold mb-6 text-red-400 border-b border-red-800 pb-2">
    Cinematic Spider-Men & Media
  </h2>

  <!-- Live Action Actors Grid -->
  <div class="grid md:grid-cols-3 gap-6 mb-10">
    <div
      class="bg-slate-800 p-4 rounded-lg border border-red-900 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://tse4.mm.bing.net/th/id/OIP.ig1CkNvsbL5zO4LAwYxX_AHaE8?r=0&rs=1&pid=ImgDetMain&o=7&rm=3"
          alt="Tobey Maguire Unmasked Spider-Man"
          class="w-full h-56 object-cover object-top rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-red-400 mb-1">Tobey Maguire</h3>
        <p class="text-xs text-gray-400 mb-2">Spider-Man Trilogy (2002–2007)</p>
        <p class="text-gray-300 text-sm">
          The original live-action cinematic Peter Parker who kicked off the
          modern superhero era with organic web-shooters.
        </p>
      </div>
    </div>

    <div
      class="bg-slate-800 p-4 rounded-lg border border-blue-900 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://static0.gamerantimages.com/wordpress/wp-content/uploads/2025/01/andrew-garfield-portraying-spider-man-cropped.jpg"
          alt="Andrew Garfield Unmasked Spider-Man"
          class="w-full h-56 object-cover object-top rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-blue-400 mb-1">Andrew Garfield</h3>
        <p class="text-xs text-gray-400 mb-2">
          The Amazing Spider-Man (2012–2014)
        </p>
        <p class="text-gray-300 text-sm">
          Brought a witty, comic-accurate banter and mechanical web-shooters to
          a darker, stylized Manhattan.
        </p>
      </div>
    </div>

    <div
      class="bg-slate-800 p-4 rounded-lg border border-red-900 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://tse4.mm.bing.net/th/id/OIP.qMl4u2OIyDhwubeLGRi0xgHaEK?r=0&rs=1&pid=ImgDetMain&o=7&rm=3"
          alt="Tom Holland Unmasked Spider-Man"
          class="w-full h-56 object-cover object-top rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-red-400 mb-1">Tom Holland</h3>
        <p class="text-xs text-gray-400 mb-2">MCU Spider-Man (2016–Present)</p>
        <p class="text-gray-300 text-sm">
          Integrated directly into the Marvel Cinematic Universe with high-tech
          Stark suits and multiverse crossovers.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
