---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Spider-Verse Hub">
  <h2 class="text-3xl font-bold text-red-500 mb-4">Contact / Submit a Variant</h2>
  <p class="text-gray-300 mb-6">Have a favorite Spider-Man suit or variant we missed? Drop a message below!</p>

  <form class="max-w-lg bg-slate-800 p-6 rounded-lg border border-slate-700 space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1">Name</label>
      <input type="text" placeholder="Your name" class="w-full p-2 rounded bg-slate-900 border border-slate-700 text-white" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Email</label>
      <input type="email" placeholder="youremail@example.com" class="w-full p-2 rounded bg-slate-900 border border-slate-700 text-white" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Favorite Variant / Message</label>
      <textarea rows="4" placeholder="Tell us your favorite version..." class="w-full p-2 rounded bg-slate-900 border border-slate-700 text-white"></textarea>
    </div>
    <button type="button" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded transition-colors">
      Send Web Signal
    </button>
  </form>
</BaseLayout>