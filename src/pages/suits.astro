---
import FeatureLayout from "../layouts/FeatureLayout.astro";
---

<FeatureLayout
  title="Suits | Spider-Verse Hub"
  heroTitle="Spider-Man Suits Gallery"
  heroSubtitle="A look at iconic suits and armor throughout Spider-Man history."
>
  <div class="grid md:grid-cols-2 gap-6">
    <div
      class="bg-slate-800 p-5 rounded-lg border border-red-900 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://images.unsplash.com/photo-1521714161819-15534968fc5f?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
          alt="Classic Red and Blue Suit"
          class="w-full h-52 object-cover rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-red-400 mb-2">
          1. Classic Red & Blue Suit
        </h3>
        <p class="text-gray-300 text-sm">
          The original suit created by Peter Parker. Simple, recognizable, and
          durable with wrist-mounted web-shooters.
        </p>
      </div>
    </div>

    <div
      class="bg-slate-800 p-5 rounded-lg border border-blue-900 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://th.bing.com/th/id/R.732fc7465732d81c93ac3a7faf8977c2?rik=n7%2b4KYCePvEy6Q&pid=ImgRaw&r=0"
          alt="Iron Spider Suit"
          class="w-full h-52 object-cover rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-blue-400 mb-2">
          2. Iron Spider Suit
        </h3>
        <p class="text-gray-300 text-sm">
          Designed by Tony Stark, this high-tech suit features metallic armor,
          mechanical spider-legs, and life-support systems.
        </p>
      </div>
    </div>

    <div
      class="bg-slate-800 p-5 rounded-lg border border-slate-600 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://www.comingsoon.net/wp-content/uploads/sites/3/2023/08/spider-man-3-header.png"
          alt="Symbiote Black Suit"
          class="w-full h-52 object-cover rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-gray-200 mb-2">
          3. Symbiote / Black Suit
        </h3>
        <p class="text-gray-300 text-sm">
          An alien organism that bonded with Spider-Man, enhancing his speed and
          strength while generating organic webbing.
        </p>
      </div>
    </div>

    <div
      class="bg-slate-800 p-5 rounded-lg border border-red-900 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://tse3.mm.bing.net/th/id/OIP.V4dqiTEYnXauu38OMv4IewHaNL?r=0&rs=1&pid=ImgDetMain&o=7&rm=3"
          alt="Advanced Suit Spider-Man Insomniac Games"
          class="w-full h-52 object-cover rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-red-400 mb-2">
          4. Advanced Suit Spider-Man Insomniac Games
        </h3>
        <p class="text-gray-300 text-sm">
          Features prominent white chest emblems made of protective carbon-fiber
          mesh designed specifically for Insomniac's Spider-Man games.
        </p>
      </div>
    </div>
  </div>
</FeatureLayout>
