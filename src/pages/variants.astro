---
import FeatureLayout from "../layouts/FeatureLayout.astro";
---

<FeatureLayout
  title="Variants | Spider-Verse Hub"
  heroTitle="Multiverse Variants"
  heroSubtitle="Meet the alternate versions of Spider-Man across dimensions."
>
  <div class="grid md:grid-cols-3 gap-6">
    <div
      class="bg-slate-800 p-5 rounded-lg border border-red-900 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://images.thedirect.com/media/photos/7tomholland.png"
          alt="Peter Parker Classic Spider-Man"
          class="w-full h-48 object-cover rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-red-400 mb-2">
          Peter Parker (Earth-616)
        </h3>
        <p class="text-gray-300 text-sm">
          The classic web-slinger from Queens, New York. Guided by aunt May's
          lesson: "With great power comes great responsibility."
        </p>
      </div>
    </div>

    <div
      class="bg-slate-800 p-5 rounded-lg border border-red-800 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://th.bing.com/th/id/OIP.mzy1Xqjk5DEyAepEh6sx7QHaHa?r=0&o=7rm=3&rs=1&pid=ImgDetMain&o=7&rm=3"
          alt="Miles Morales Spider-Man"
          class="w-full h-48 object-cover rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-red-400 mb-2">
          Miles Morales (Earth-1610)
        </h3>
        <p class="text-gray-300 text-sm">
          Brooklyn teenager with bio-electric venom blasts and camouflage
          abilities who inherited the mantle in his dimension.
        </p>
      </div>
    </div>

    <div
      class="bg-slate-800 p-5 rounded-lg border border-purple-900 flex flex-col justify-between"
    >
      <div>
        <img
          src="https://tse1.explicit.bing.net/th/id/OIP.ND4Fjwj4EM1hvlJY8S3NZwHaEK?r=0&rs=1&pid=ImgDetMain&o=7&rm=3"
          alt="Gwen Stacy Spider-Gwen"
          class="w-full h-48 object-cover rounded-md mb-4"
        />
        <h3 class="text-xl font-bold text-purple-400 mb-2">
          Gwen Stacy (Earth-65)
        </h3>
        <p class="text-gray-300 text-sm">
          Known as Ghost-Spider or Spider-Gwen, she possesses incredible agility
          and plays drums in her band, The Mary Janes.
        </p>
      </div>
    </div>
  </div>
</FeatureLayout>
